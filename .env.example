# Cloudflare D1 Database (REST API)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=meridian-uploads
R2_PUBLIC_URL=

# BinderPay SNAP BI Payment Gateway (https://binderpay.id/docs)
# Environment: "sandbox" or "production"
BINDERPAY_ENV=sandbox
# Registered Partner ID from BinderPay Dashboard (X-PARTNER-ID)
BINDERPAY_PARTNER_ID=
# Merchant RSA Private Key in PEM format (use \n for single-line env vars on Vercel, or Base64-encoded PEM)
BINDERPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional: override BinderPay Public Key PEM (defaults to official https://binderpay.id/docs/binderpay-public.pem)
BINDERPAY_PUBLIC_KEY=
# Optional: override enabled channels (comma-separated)
# Supported: QRIS,BCA,MANDIRI,BNI,BRI,PERMATA,BSI,CIMB,MUAMALAT,SINARMAS,BNC,MAYBANK,LINK
BINDERPAY_ENABLED_CHANNELS=QRIS,BCA,MANDIRI,BNI,BRI,PERMATA,BSI,CIMB,LINK
# Optional: expiry durations in minutes
BINDERPAY_QRIS_EXPIRY_MINUTES=30
BINDERPAY_VA_EXPIRY_MINUTES=1440
# Public site origin used for Payment Link redirect_url & callback_url
NEXT_PUBLIC_SITE_URL=https://clothes-sc8z-plum.vercel.app
